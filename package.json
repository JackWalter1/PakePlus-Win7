{
    "name": "ta​book​",
    "version": "1.0.0",
    "description": "跨平台桌面应用，支持 Windows 7",
    "main": "main.js",
    "scripts": {
        "bundle:keyboard": "node scripts/bundle-keyboard.mjs",
        "start": "node scripts/bundle-keyboard.mjs && electron .",
        "build": "node scripts/bundle-keyboard.mjs && electron-builder",
        "build:win": "node scripts/bundle-keyboard.mjs && electron-builder --win",
        "build:win32": "node scripts/bundle-keyboard.mjs && electron-builder --win --ia32",
        "build:win64": "node scripts/bundle-keyboard.mjs && electron-builder --win --x64",
        "build:mac": "node scripts/bundle-keyboard.mjs && electron-builder --mac",
        "build:linux": "node scripts/bundle-keyboard.mjs && electron-builder --linux",
        "build:linux:amd64": "node scripts/bundle-keyboard.mjs && electron-builder --linux --x64",
        "build:linux:arm64": "node scripts/bundle-keyboard.mjs && electron-builder --linux --arm64",
        "build:linux:arm": "node scripts/bundle-keyboard.mjs && electron-builder --linux --armv7l",
        "icon:icns": "node scripts/createIcon.cjs -icon app-icon.png -padding 1 -format icns",
        "icon:ico": "node scripts/createIcon.cjs -icon app-icon.png",
        "worker:pp": "node scripts/ppworker.cjs"
    },
    "keywords": [
        "electron",
        "desktop",
        "cross-platform"
    ],
    "author": {
        "name": "ta​book​",
        "email": "support@pakeplus.com"
    },
    "license": "MIT",
    "devDependencies": {
        "electron": "^22.3.27",
        "electron-builder": "^24.9.1",
        "esbuild": "^0.28.2",
        "png-to-ico": "^3.0.1",
        "sharp": "^0.34.5"
    },
    "build": {
        "appId": "com.ta​book​.win7",
        "productName": "ta​book​",
        "icon": "app-icon.ico",
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "package.json",
            "index.html",
            "renderer.js",
            "password-dialog.html",
            "webview-keyboard-preload.js",
            "keyboard/dist/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "ia32",
                        "x64"
                    ]
                },
                {
                    "target": "portable",
                    "arch": [
                        "ia32",
                        "x64"
                    ]
                }
            ],
            "icon": "app-icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "app-icon.icns"
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "icon": "app-icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "perMachine": true,
            "runAfterFinish": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        }
    },
    "dependencies": {
        "@zh-keyboard/pinyin": "^2.1.2",
        "@zh-keyboard/vue": "^2.1.2",
        "commander": "^13.1.0",
        "fs-extra": "^11.3.0"
    }
}
